# Estágio 1: build dos arquivos estáticos
FROM node:20-alpine AS build

WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

# Estágio 2: serve os estáticos com nginx (imagem final não tem Node/Vite —
# é só nginx + os arquivos já compilados, leve e rápido de replicar)
FROM nginx:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.spa.conf /etc/nginx/conf.d/default.conf

EXPOSE 80